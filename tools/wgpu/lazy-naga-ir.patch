diff --git a/wgpu-hal/src/lib.rs b/wgpu-hal/src/lib.rs
index 3f36e67..7da6284 100644
--- a/wgpu-hal/src/lib.rs
+++ b/wgpu-hal/src/lib.rs
@@ -264,6 +264,41 @@ pub mod noop;
 pub mod vulkan;
 
 pub mod auxil;
+
+/// LGP patch: whether backends that support it keep only a shader module's
+/// WGSL text and re-parse it per pipeline, instead of holding the naga IR and
+/// its `ModuleInfo` for the module's lifetime (Metal; Vulkan for modules it
+/// keeps as IR). On unless the environment sets `LGP_WGPU_LAZY_IR=0`.
+pub fn lazy_naga_ir_enabled() -> bool {
+    #[cfg(any(metal, vulkan))]
+    {
+        static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *ENABLED.get_or_init(|| std::env::var("LGP_WGPU_LAZY_IR").map_or(true, |v| v != "0"))
+    }
+    #[cfg(not(any(metal, vulkan)))]
+    false
+}
+
+/// LGP patch: the IR and analysis of a module kept as WGSL text. wgpu-core
+/// validated it with its device's capabilities when the module was made, so
+/// all capabilities are allowed here; the analysis does not depend on them.
+#[cfg(any(metal, vulkan))]
+pub(crate) fn reparse_wgsl(
+    source: &DebugSource,
+) -> Result<(naga::Module, naga::valid::ModuleInfo), String> {
+    profiling::scope!("naga::reparse_wgsl");
+    let module = naga::front::wgsl::parse_str(&source.source_code)
+        .map_err(|e| e.emit_to_string(&source.source_code))?;
+    let info = naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::all(),
+    )
+    .subgroup_stages(naga::valid::ShaderStages::all())
+    .subgroup_operations(naga::valid::SubgroupOperationSet::all())
+    .validate(&module)
+    .map_err(|e| alloc::format!("{:?}", e.into_inner()))?;
+    Ok((module, info))
+}
 pub mod api {
     #[cfg(dx12)]
     pub use super::dx12::Api as Dx12;
