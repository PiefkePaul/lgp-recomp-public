+/// LGP patch: whether a pipeline keeps the `MTLLibrary` of each stage after
+/// its pipeline state is built (nothing reads it then). Kept unless the
+/// environment sets `LGP_WGPU_METAL_DROP_LIBRARY=1`.
+fn keep_stage_library() -> bool {
+    static KEEP: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *KEEP.get_or_init(|| std::env::var("LGP_WGPU_METAL_DROP_LIBRARY").map_or(true, |v| v != "1"))
+}
