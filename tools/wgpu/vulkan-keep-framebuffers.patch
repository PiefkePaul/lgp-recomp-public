+/// LGP patch: with `LGP_WGPU_KEEP_FRAMEBUFFERS=1` an encoder keeps its
+/// framebuffers across `reset_all` instead of destroying all of them, so a
+/// render pass with the same attachments as in an earlier use of the encoder
+/// does not create one again (`vkCreateFramebuffer` per pass). The key holds
+/// the views' identities, which are never reused, so a framebuffer of a
+/// destroyed view is never hit; it goes after `KEEP_FRAMEBUFFER_RESETS`
+/// resets without use, and all go past `MAX_KEPT_FRAMEBUFFERS`.
+fn keep_framebuffers() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("LGP_WGPU_KEEP_FRAMEBUFFERS").is_ok_and(|v| v == "1"))
+}
+const KEEP_FRAMEBUFFER_RESETS: u32 = 16;
+const MAX_KEPT_FRAMEBUFFERS: usize = 256;
+
