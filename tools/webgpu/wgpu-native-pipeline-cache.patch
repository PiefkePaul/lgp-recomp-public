+pub struct WGPUPipelineCacheImpl {
+    context: Arc<Context>,
+    id: id::PipelineCacheId,
+}
+impl Drop for WGPUPipelineCacheImpl {
+    fn drop(&mut self) {
+        if !thread::panicking() {
+            self.context.pipeline_cache_drop(self.id);
+        }
+    }
+}
+
+/// The cache chained to a pipeline descriptor (lgp-recomp patch).
+unsafe fn pipeline_cache_from_chain(
+    mut chain: *const native::WGPUChainedStruct,
+) -> Option<id::PipelineCacheId> {
+    while let Some(next) = chain.as_ref() {
+        if next.sType == native::WGPUSType_PipelineCacheExtras {
+            let extras = &*(chain as *const native::WGPUPipelineCacheExtras);
+            return extras.cache.as_ref().map(|c| c.id);
+        }
+        chain = next.next;
+    }
+    None
+}
