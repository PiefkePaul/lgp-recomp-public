# A free stand-in for the console's standard system font (pl:u), so a game
# folder without systemdata/ from the user's firmware still has text.
#
# M PLUS Rounded 1c (SIL Open Font License 1.1) from the Google Fonts
# repository, pinned by commit and SHA-256, is downloaded at configure time
# and compiled into lgp_free_font as a byte array; pl:u serves it when
# <game>/systemdata/0100000000000811 is missing
# (docs/knowledge/horizon-pl-shared-font.md). The TTF is embedded unchanged:
# its name table carries the copyright notice and the license, as the OFL
# asks of bundled copies. LGP_FREE_FONT_FILE points at a local copy instead
# (offline builds; checked against the same hash).
# Result: target lgp_free_font and LGP_FREE_FONT_AVAILABLE. Without it a game
# folder needs the firmware's fonts, as before.

option(LGP_ENABLE_FREE_FONT "Embed a free stand-in for the system font (downloads M PLUS Rounded 1c, OFL)" ON)
set(LGP_FREE_FONT_FILE "" CACHE FILEPATH "Local MPLUSRounded1c-Medium.ttf to embed instead of downloading it")

set(LGP_FREE_FONT_AVAILABLE OFF)
if(NOT LGP_ENABLE_FREE_FONT)
    return()
endif()

set(_font_name "MPLUSRounded1c-Medium.ttf")
set(_font_commit "ddf386ba1b9fbc6b2c818f1ddcd9148f54ced94b")
set(_font_sha256 "adfde1b6bae58719c4e0144612a94232e72fc5ca655c4722165fe88d06521a70")
set(_font_dir "${CMAKE_BINARY_DIR}/_deps/free_font")
set(_font "${_font_dir}/${_font_name}")

if(LGP_FREE_FONT_FILE)
    set(_font "${LGP_FREE_FONT_FILE}")
elseif(NOT EXISTS "${_font}")
    file(DOWNLOAD
        "https://raw.githubusercontent.com/google/fonts/${_font_commit}/ofl/mplusrounded1c/${_font_name}"
        "${_font}.part"
        STATUS _status)
    # Hash checked by hand: with EXPECTED_HASH a failed download stops the
    # configure instead of reaching this fallback.
    list(GET _status 0 _code)
    if(_code EQUAL 0)
        file(SHA256 "${_font}.part" _got)
    endif()
    if(NOT _code EQUAL 0 OR NOT _got STREQUAL _font_sha256)
        file(REMOVE "${_font}.part")
        message(WARNING "free font: download failed (${_status}); a game folder needs systemdata/ from the firmware")
        return()
    endif()
    file(RENAME "${_font}.part" "${_font}")
endif()
file(SHA256 "${_font}" _have)
if(NOT _have STREQUAL _font_sha256)
    message(WARNING "free font: ${_font} has SHA-256 ${_have}, expected ${_font_sha256}; not embedded")
    return()
endif()

# The array is written once per font file (a few seconds); the stamp keeps
# reconfigures cheap.
set(_source "${_font_dir}/free_font_data.cpp")
set(_stamp "${_font_dir}/free_font_data.sha256")
set(_old "")
if(EXISTS "${_stamp}")
    file(READ "${_stamp}" _old)
endif()
if(NOT EXISTS "${_source}" OR NOT _old STREQUAL _font_sha256)
    file(READ "${_font}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _bytes "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
    # One line per 64 bytes keeps compilers and editors happy.
    string(REGEX REPLACE "((0x..,){64})" "\\1\n" _hex "${_hex}")
    file(WRITE "${_source}.part"
        "// Generated by cmake/LgpFreeFont.cmake from ${_font_name} (SIL Open Font License 1.1,\n"
        "// copyright and license in the font's name table). Do not edit.\n"
        "#include \"lgp/hle/free_font.hpp\"\n\n"
        "namespace {\n"
        "alignas(4) const unsigned char kFont[${_bytes}] = {\n${_hex}\n};\n"
        "}  // namespace\n\n"
        "namespace lgp::hle {\n"
        "std::span<const uint8_t> free_system_font() { return {kFont, sizeof(kFont)}; }\n"
        "}  // namespace lgp::hle\n")
    file(RENAME "${_source}.part" "${_source}")
    file(WRITE "${_stamp}" "${_font_sha256}")
endif()

add_library(lgp_free_font STATIC "${_source}")
target_include_directories(lgp_free_font PUBLIC "${CMAKE_SOURCE_DIR}/runtime/hle/include")
target_compile_features(lgp_free_font PUBLIC cxx_std_20)
set(LGP_FREE_FONT_AVAILABLE ON)
