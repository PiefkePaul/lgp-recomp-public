<!doctype html>
<!-- Browser front end of an lgp program (P6), generated by lgp_add_web_page().
     The user picks their own extracted game data (a folder with exefs/ and
     romfs/, as tools/extract writes it) from the local disk; it is copied
     into this browser's Origin Private File System and never leaves the
     machine. The program (@LGP_WEB_SCRIPT@) is loaded on Start.
     URL parameters: args=... (appended to the default argv), argv=... (instead
     of it), autostart=1 (start as soon as data is in OPFS), noconfirm=1 (no
     question before a save import replaces the saves; tests).
     Needs cross-origin isolation for threads: serve with tools/web/serve.py. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@LGP_WEB_TITLE@</title>
<link rel="icon" type="image/svg+xml" href="lgp-icon.svg">
<link rel="apple-touch-icon" href="lgp-icon-180.png">
<style>
  :root { color-scheme: light dark; --bg: #f4f4f2; --fg: #1d1d1b; --muted: #5d5d58; --panel: #fff; --line: #d6d6d0; --accent: #1f5fbf; --bad: #b3261e; }
  @media (prefers-color-scheme: dark) { :root { --bg: #121212; --fg: #e4e4e0; --muted: #a0a09a; --panel: #1c1c1c; --line: #34342f; --accent: #7aa7ff; --bad: #ff8a80; } }
  body { margin: 0; padding: 16px; font: 14px system-ui, sans-serif; background: var(--bg); color: var(--fg); }
  main { max-width: 1280px; margin: 0 auto; }
  h1 { font-size: 18px; margin: 0 0 12px; }
  canvas { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 12px; margin: 12px 0; }
  .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  button, label.button { font: inherit; padding: 6px 12px; border-radius: 4px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer; }
  button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  button:disabled, label.button.disabled { opacity: 0.5; cursor: default; pointer-events: none; }
  input[type=file] { display: none; }
  .muted { color: var(--muted); }
  .bad { color: var(--bad); }
  progress { width: 100%; }
  #log { white-space: pre-wrap; font: 12px ui-monospace, monospace; max-height: 40vh; overflow: auto; }
</style>
</head>
<body>
<main>
<h1>@LGP_WEB_TITLE@</h1>
<canvas id="canvas" width="1280" height="720"></canvas>
<div class="panel">
  <div class="row">
    <label class="button" for="pick-dir">Choose game data folder…</label>
    <input id="pick-dir" type="file" webkitdirectory multiple>
    <button id="start" class="primary" disabled>Start</button>
    <button id="clear-data">Delete game data</button>
    <button id="clear-saves">Delete saves</button>
    <button id="export-saves">Export saves</button>
    <label class="button" for="import-saves" id="import-saves-label">Import saves…</label>
    <input id="import-saves" type="file" accept=".zip,application/zip">
  </div>
  <p class="muted">Pick the folder with <code>exefs/</code> and <code>romfs/</code> from your own dump
    (as <code>tools/extract</code> writes it). Only those parts are copied, into this browser's private
    storage for this page; nothing is uploaded. Saves live only in this browser: export them now and then
    as a ZIP file for a backup (it holds what the game last saved).</p>
  <div id="inventory" class="muted">checking browser storage…</div>
  <progress id="progress" max="1" value="0" hidden></progress>
  <div id="status"></div>
</div>
<div id="log"></div>
</main>
<script type="application/json" id="lgp-config">{"script": "@LGP_WEB_SCRIPT@", "args": "@LGP_WEB_ARGS@"}</script>
<script src="lgp_web.js"></script>
<script>
(async () => {
  const W = window.LgpWeb;
  const config = JSON.parse(document.getElementById('lgp-config').textContent);
  const query = new URLSearchParams(location.search);
  const $ = (id) => document.getElementById(id);
  const logEl = $('log'), statusEl = $('status'), invEl = $('inventory'), progressEl = $('progress');
  const startBtn = $('start'), pickInput = $('pick-dir');
  let running = false, busy = false, inv = null;

  const logLines = [];
  function out(text) {
    console.log(text);
    logLines.push(text);
    if (logLines.length > 2000) logLines.splice(0, logLines.length - 2000);
    logEl.textContent = logLines.join('\n');
  }
  function status(text, bad) {
    statusEl.textContent = text;
    statusEl.className = bad ? 'bad' : '';
  }
  function updateButtons() {
    startBtn.disabled = running || busy || !inv || inv.files === 0;
    for (const id of ['clear-data', 'clear-saves', 'import-saves']) $(id).disabled = running || busy;
    $('import-saves-label').classList.toggle('disabled', running || busy);
    $('export-saves').disabled = busy;  // while running too: it reads only committed files
    pickInput.disabled = running || busy;
  }
  async function refresh() {
    inv = W.hasOpfs() ? await W.inventory() : null;
    if (!inv) invEl.textContent = 'This browser has no Origin Private File System.';
    else if (inv.files === 0) invEl.textContent = 'No game data in this browser yet.';
    else invEl.textContent = `Game data in this browser: ${inv.files} files, ${W.formatBytes(inv.bytes)}; ` +
      `modules: ${inv.modules.join(', ') || 'none'}; RomFS: ${inv.romfs ? 'tree' : inv.romfsBin ? 'romfs.bin' : 'none'}`;
    updateButtons();
    return inv;
  }

  function start() {
    if (running) return;
    running = true;
    updateButtons();
    const args = W.programArgs(config.args, query);
    out('starting ' + config.script + ' ' + args.join(' '));
    status('running');
    W.startProgram({
      script: config.script, args, canvas: $('canvas'), print: out,
      onExit: (code) => { status('exited with ' + code, code !== 0); out('exit code ' + code); },
    });
  }

  async function importEntries(entries) {
    const plan = W.planCopy(entries);
    out(`picked ${entries.length} files: copying ${plan.copies.length} (${W.formatBytes(plan.bytes)}), ` +
        `leaving out ${plan.ignored.length}`);
    if (plan.copies.length === 0) {
      status('Nothing to copy: the folder has no exefs/, romfs/ or module files.', true);
      return;
    }
    if (!plan.modules.length) out('warning: no modules (exefs) in the picked folder');
    busy = true;
    updateButtons();
    try {
      const space = await W.prepareStorage(plan.bytes, {
        onPersisted: (ok) => out(ok ? 'persistent storage granted'
                                    : 'note: the browser did not grant persistent storage; it may evict the data'),
      });
      if (!space.enough) {
        status(`Not enough browser storage: ${W.formatBytes(plan.bytes)} needed, ` +
               `${W.formatBytes(space.available)} available.`, true);
        return;
      }
      if (space.persisted === null) out('note: the browser asks whether to keep the data; copying meanwhile');
      else if (!space.persisted) out('note: the browser did not grant persistent storage; it may evict the data');
      progressEl.hidden = false;
      progressEl.value = 0;
      const t0 = performance.now();
      const done = await W.copyToOpfs(plan, (p) => {
        progressEl.value = p.total ? p.bytes / p.total : 1;
        status(`copying ${p.files}/${plan.copies.length} files, ${W.formatBytes(p.bytes)} of ${W.formatBytes(p.total)}`);
      });
      out(`copied: ${done.files} files, ${done.bytes} bytes in ${((performance.now() - t0) / 1000).toFixed(1)} s`);
      status('Game data copied.');
    } catch (e) {
      status('Copy failed: ' + e.message, true);
      out('copy failed: ' + e.message);
    } finally {
      busy = false;
      progressEl.hidden = true;
      await refresh();
    }
    if (query.get('autostart') === '1' && inv && inv.files > 0) start();
  }

  pickInput.addEventListener('change', () => {
    const entries = W.entriesFromFileList(pickInput.files);
    pickInput.value = '';
    if (entries.length) importEntries(entries);
  });
  startBtn.addEventListener('click', start);
  $('clear-data').addEventListener('click', async () => {
    if (!confirm('Delete the game data copied into this browser?')) return;
    await W.clearData();
    out('game data deleted');
    await refresh();
  });
  $('export-saves').addEventListener('click', async () => {
    busy = true;
    updateButtons();
    try {
      const backup = await W.exportSaves();
      if (backup.files === 0) {
        status('No saves in this browser yet.');
        return;
      }
      const url = URL.createObjectURL(new Blob([backup.zip], { type: 'application/zip' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = backup.name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
      out(`saves exported: ${backup.files} files to ${backup.name}`);
      status(`Saves exported to ${backup.name}.`);
    } catch (e) {
      status('Export failed: ' + e.message, true);
      out('export failed: ' + e.message);
    } finally {
      busy = false;
      updateButtons();
    }
  });
  $('import-saves').addEventListener('change', async () => {
    const file = $('import-saves').files[0];
    $('import-saves').value = '';
    if (!file || running) return;
    if (!query.has('noconfirm') && !confirm('Replace all saves in this browser with the ones in ' + file.name + '?'))
      return;
    busy = true;
    updateButtons();
    try {
      const plan = await W.importSaves(file);
      if (plan.ignored.length) out('left out of the import: ' + plan.ignored.join(', '));
      out(`saves imported: ${plan.files.length} files from ${file.name}`);
      status(`Saves imported from ${file.name}.`);
    } catch (e) {
      status('Import failed: ' + e.message, true);
      out('import failed: ' + e.message);
    } finally {
      busy = false;
      updateButtons();
    }
  });
  $('clear-saves').addEventListener('click', async () => {
    if (!confirm('Delete all saves of this page in this browser?')) return;
    await W.clearSaves();
    out('saves deleted');
    await refresh();
  });

  if (!self.crossOriginIsolated)
    out('not cross-origin isolated: threads need COOP/COEP headers (tools/web/serve.py)');
  if (!navigator.gpu)
    out('this browser has no WebGPU (navigator.gpu)');
  // return_call 0: lifted code needs Wasm tail calls (Chrome 112, Firefox 121, Safari 18.2).
  if (!WebAssembly.validate(new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0, 1, 4, 1, 96, 0, 0, 3, 2, 1, 0, 10, 6, 1, 4, 0, 18, 0, 11])))
    out('this browser has no WebAssembly tail calls: the game cannot load (needs Chrome 112, Firefox 121 or Safari 18.2)');
  await refresh();
  out('ready');
  if (query.get('autostart') === '1' && inv && inv.files > 0) start();
})();
</script>
</body>
</html>
