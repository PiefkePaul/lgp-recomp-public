# Test of cmake/LgpCopyGame.cmake (boot.copy_game): links are copied as the
# files they point to, unchanged files are kept, stale files and folders go,
# the Xcode destination comes from Xcode's environment, an older replacement
# of the same size is copied too, and a cleared option removes what an
# earlier copy put there (STAMP/REMOVE_STAMP).
#   cmake -DSCRIPT=<LgpCopyGame.cmake> -DWORK=<empty dir> -P copy_game_test.cmake
set(src "${WORK}/src")
set(dst "${WORK}/package/game")
set(outside "${WORK}/outside")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${src}/exefs" "${src}/stale_dir/sub" "${outside}/linked_dir")
file(WRITE "${src}/exefs/main" "code")
file(WRITE "${src}/.hidden" "h")
file(WRITE "${outside}/romfs.bin" "romfs image")
file(WRITE "${outside}/linked_dir/file" "in a linked folder")
file(CREATE_LINK "${outside}/romfs.bin" "${src}/romfs.bin" SYMBOLIC)
file(CREATE_LINK "${outside}/linked_dir" "${src}/systemdata" SYMBOLIC)
file(WRITE "${src}/stale_dir/sub/old" "old")
# Written now, so older than everything written after the sleep below.
file(WRITE "${WORK}/older/seed.lgppipes" "SEED")

function(run)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN} -P "${SCRIPT}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    set(rc "${rc}" PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
endfunction()
function(expect_file path content)
    if(IS_SYMLINK "${path}" OR NOT EXISTS "${path}")
        message(FATAL_ERROR "${path}: not a regular file")
    endif()
    file(READ "${path}" got)
    if(NOT got STREQUAL content)
        message(FATAL_ERROR "${path}: '${got}', expected '${content}'")
    endif()
endfunction()

run("-DSRC=${src}" "-DDST=${dst}")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "copy failed: ${out}")
endif()
expect_file("${dst}/exefs/main" "code")
expect_file("${dst}/.hidden" "h")
expect_file("${dst}/romfs.bin" "romfs image")
expect_file("${dst}/systemdata/file" "in a linked folder")
if(IS_SYMLINK "${dst}/systemdata")
    message(FATAL_ERROR "${dst}/systemdata is a link")
endif()
expect_file("${dst}/stale_dir/sub/old" "old")

# Second run: a changed link target is copied again, stale entries go.
file(REMOVE_RECURSE "${src}/stale_dir")
file(REMOVE "${src}/.hidden")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
file(WRITE "${outside}/romfs.bin" "new romfs image")
run("-DSRC=${src}" "-DDST=${dst}")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "second copy failed: ${out}")
endif()
expect_file("${dst}/romfs.bin" "new romfs image")
foreach(gone stale_dir .hidden)
    if(EXISTS "${dst}/${gone}")
        message(FATAL_ERROR "${dst}/${gone} was not removed")
    endif()
endforeach()

# A dangling link stops the build.
file(CREATE_LINK "${outside}/missing" "${src}/dangling" SYMBOLIC)
run("-DSRC=${src}" "-DDST=${dst}")
# The message wraps at a path-dependent spot.
if(rc EQUAL 0 OR NOT out MATCHES "does[ \t\r\n]+not[ \t\r\n]+exist")
    message(FATAL_ERROR "dangling link accepted: ${out}")
endif()
file(REMOVE "${src}/dangling")

# Xcode: destination from TARGET_BUILD_DIR/UNLOCALIZED_RESOURCES_FOLDER_PATH.
run("-DSRC=${src}" "-DDST=" -DDST_XCODE_RESOURCES=game)
if(rc EQUAL 0)
    message(FATAL_ERROR "Xcode mode ran without Xcode's environment")
endif()
set(ENV{TARGET_BUILD_DIR} "${WORK}/xcode/Release-appletvos")
set(ENV{UNLOCALIZED_RESOURCES_FOLDER_PATH} "lgp_game.app")
run("-DSRC=${src}" "-DDST=" -DDST_XCODE_RESOURCES=game)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Xcode copy failed: ${out}")
endif()
expect_file("${WORK}/xcode/Release-appletvos/lgp_game.app/game/exefs/main" "code")

# A single file (LGP_APP_PIPELINE_SEED), also through a link.
file(WRITE "${outside}/seed.lgppipes" "seed")
file(CREATE_LINK "${outside}/seed.lgppipes" "${WORK}/seed-link" SYMBOLIC)
run("-DSRC=${WORK}/seed-link" "-DDST=${WORK}/package/pipeline-seed.lgppipes")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "file copy failed: ${out}")
endif()
expect_file("${WORK}/package/pipeline-seed.lgppipes" "seed")
run("-DSRC=${outside}/seed.lgppipes" "-DDST=" -DDST_XCODE_RESOURCES=pipeline-seed.lgppipes)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Xcode file copy failed: ${out}")
endif()
expect_file("${WORK}/xcode/Release-appletvos/lgp_game.app/pipeline-seed.lgppipes" "seed")

# A replacement of the same size with an older time stamp (rsync -t) is
# copied too, and an unchanged one is kept (its time stamp went along).
set(seed_dst "${WORK}/package/pipeline-seed.lgppipes")
file(COPY "${WORK}/older/seed.lgppipes" DESTINATION "${outside}")
run("-DSRC=${outside}/seed.lgppipes" "-DDST=${seed_dst}" "-DSTAMP=${WORK}/seed.stamp")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "older file copy failed: ${out}")
endif()
expect_file("${seed_dst}" "SEED")
file(TIMESTAMP "${outside}/seed.lgppipes" t_src "%s" UTC)
file(TIMESTAMP "${seed_dst}" t_dst "%s" UTC)
if(NOT t_src EQUAL t_dst)
    message(FATAL_ERROR "copy has time ${t_dst}, source ${t_src}")
endif()
if(EXISTS "${WORK}/package/.lgp-copy-stage")
    message(FATAL_ERROR "staging folder left behind")
endif()

# Cleared options: the stamped destinations go, nothing without a stamp.
run("-DSRC=${src}" "-DDST=${dst}" "-DSTAMP=${WORK}/game.stamp")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "stamped copy failed: ${out}")
endif()
# A second destination with the same stamp (Xcode: Debug and Release),
# recorded once even when copied twice.
set(dst2 "${WORK}/package-release/game")
foreach(i 1 2)
    run("-DSRC=${src}" "-DDST=${dst2}" "-DSTAMP=${WORK}/game.stamp")
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "second stamped copy failed: ${out}")
    endif()
endforeach()
file(STRINGS "${WORK}/game.stamp" listed)
list(LENGTH listed n)
if(NOT n EQUAL 2)
    message(FATAL_ERROR "game.stamp lists ${n} destinations, expected 2: ${listed}")
endif()
file(WRITE "${WORK}/package/user-file" "keep")
foreach(stamp seed game)
    run("-DREMOVE_STAMP=${WORK}/${stamp}.stamp")
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "removing ${stamp} failed: ${out}")
    endif()
    if(EXISTS "${WORK}/${stamp}.stamp")
        message(FATAL_ERROR "${stamp}.stamp was not removed")
    endif()
endforeach()
foreach(gone "${seed_dst}" "${dst}" "${dst2}")
    if(EXISTS "${gone}")
        message(FATAL_ERROR "${gone} was not removed")
    endif()
endforeach()
expect_file("${WORK}/package/user-file" "keep")
run("-DREMOVE_STAMP=${WORK}/seed.stamp")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "removing without a stamp failed: ${out}")
endif()
